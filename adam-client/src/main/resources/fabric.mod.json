{
  "schemaVersion": 1,
  "id": "adam",
  "version": "${version}",
  "name": "Adam Client",
  "description": "All-in-one client: Blocks (highlight chosen blocks), Cam (freecam) and Wings (fly, boatfly) behind one module menu.",
  "authors": ["Adam"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.adam.client.AdamClient"]
  },
  "mixins": [
    {
      "config": "adam.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
